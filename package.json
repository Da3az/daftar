{
  "name": "daftar",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run -w @daftar/api db:generate",
    "db:migrate": "npm run -w @daftar/api db:migrate",
    "dev:api": "npm run -w @daftar/api dev",
    "dev:web": "npm run -w @daftar/web dev",
    "exchange:db:create": "docker compose exec db psql -U daftar -d postgres -c 'CREATE DATABASE daftar_exchange'",
    "exchange:db:migrate": "DATABASE_URL=postgres://daftar:daftar@127.0.0.1:55432/daftar_exchange npm run -w @daftar/api db:migrate",
    "dev:exchange": "EXCHANGE_BOTS_ENABLED=true OUTBOX_WORKER_ENABLED=true DATABASE_URL=postgres://daftar:daftar@127.0.0.1:55432/daftar_exchange npm run -w @daftar/api dev",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run --workspaces --if-present test",
    "openapi:dump": "npm run -w @daftar/api openapi:dump",
    "postman:build": "node scripts/build-postman.mjs",
    "seed": "npm run -w @daftar/api seed --",
    "seed:verify": "npm run -w @daftar/api seed:verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "openapi-to-postmanv2": "6.4.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
