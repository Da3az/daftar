# Copy to .env. Every variable is validated at boot by apps/api/src/env.ts; the
# process exits 78 (EX_CONFIG) rather than starting with a bad value.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# No default in code on purpose: a default of localhost is how a test run ends up
# writing to a developer's real database. Port 55432 is the compose service,
# published on loopback only.
DATABASE_URL=postgres://daftar:daftar@127.0.0.1:55432/daftar

# (API instances x DB_POOL_MAX) + (workers x worker pool) + superuser_reserved
#   must stay <= postgres max_connections. Phase 6 writes the real arithmetic.
DB_POOL_MAX=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000

LOG_LEVEL=info
# Human-readable logs for local work. Leave false anywhere the lines are parsed.
LOG_PRETTY=true

# Process-wide DEFAULTS only. Every one is overridable per request by a header,
# so the chaos panel can run two profiles side by side without a restart.
LEDGER_CONCURRENCY_MODE=serializable
DAFTAR_NAIVE_OVERDRAFT=false
DAFTAR_NAIVE_LOST_UPDATE=false

# Whether request headers may override the flags above. Defaults to true outside
# production. An unauthenticated header that selects a deliberately-broken ledger
# path must not be reachable by default.
# ALLOW_FLAG_HEADERS=true

# Comma-separated. Empty means same-origin only.
CORS_ORIGINS=http://localhost:5173
