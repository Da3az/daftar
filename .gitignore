# Local build specification — an input document, not part of the project.
BUILD-PROMPT.md

node_modules/
dist/
build/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

# k6 / load artefacts that are regenerated, not evidence
load/out/
*.log

# terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfplan
infra/**/.terraform.lock.hcl.bak

# generated route tree is committed on purpose (TanStack Router) — do not ignore it

.DS_Store

# Pinned local tooling fetched by scripts/install-k6.sh
.tools/

# Static build output.
apps/web/dist/

# Only the root README.md is tracked as Markdown, and docs/ (generated evidence,
# infrastructure notes) never goes to GitHub. ci.yml's "Tracked-file policy"
# step fails the build if one is force-added.
*.md
!/README.md
/docs/
