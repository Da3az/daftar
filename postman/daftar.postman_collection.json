                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-daftar-concurrency-mode",
                "value": "serializable",
                "disabled": true,
                "description": "pessimistic | serializable | advisory"
              },
              {
                "key": "x-daftar-naive-overdraft",
                "value": "true",
