    {
      "id": "c8eb635a-e8d7-4110-8473-8fde88840bff",
      "name": "orders",
      "description": {
        "content": "Order placement — the measured write path",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "61765afc-19c6-4332-9b4e-0eae92eb85a1",
          "name": "Place an order. The measured write path.",
          "request": {
            "name": "Place an order. The measured write path.",
            "description": {
              "content": "Writes four ledger entries in one transaction — two in USD, two in the\nasset — plus the order row, atomically.\n\n**The price is frozen at order time** from the `instruments` table and\nnever re-read. This endpoint makes no network call of any kind: no\nprice feed, no third-party API, no DNS. That is what makes the\nbenchmark numbers in docs/evidence/ reproducible, and what makes the\namount quoted the amount charged.\n\nThe concurrency strategy is chosen per request via\n`x-daftar-concurrency-mode`: `pessimistic`, `serializable` or\n`advisory`. All three are correct; see the trade-off table in the\nREADME. `attempts` in the response reports how many tries the write\ntook, which is non-trivial only under `serializable`.",
              "type": "text/plain"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "orders"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-daftar-concurrency-mode",
                "value": "serializable",
                "disabled": true,
                "description": "pessimistic | serializable | advisory"
              },
              {
                "key": "x-daftar-naive-overdraft",
                "value": "true",
                "disabled": true,
                "description": "Phase 1 naive path: app-level funds check then atomic decrement. Overdrafts."
              },
              {
                "key": "x-daftar-naive-lost-update",
                "value": "true",
                "disabled": true,
                "description": "Phase 1 naive path: read, compute in JS, write absolute. Loses updates."
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"cash-0001\",\n  \"accountId\": \"cash-0001\",\n  \"symbol\": \"string\",\n  \"side\": \"sell\",\n  \"quantity\": \"0.50000000\"\n}",
