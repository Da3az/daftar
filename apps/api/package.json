{
  "name": "@daftar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "openapi:dump": "node --env-file-if-exists=../../.env src/openapi/dump.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed/seed.ts",
    "seed:verify": "node --env-file-if-exists=../../.env src/seed/verify.ts"
  },
  "dependencies": {
    "@daftar/money": "0.1.0",
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@fastify/type-provider-zod": "1.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "vitest": "5.1.0"
  }
}
