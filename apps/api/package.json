{
  "name": "@daftar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "openapi:dump": "node --env-file-if-exists=../../.env src/openapi/dump.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed/seed.ts",
    "seed:verify": "node --env-file-if-exists=../../.env src/seed/verify.ts",
    "dev:workers": "node --env-file-if-exists=../../.env --watch src/workers.ts",
    "start:workers": "node src/workers.ts",
    "kafka:topics": "node --env-file-if-exists=../../.env src/events/cli/topics.ts",
    "kafka:backfill": "node --env-file-if-exists=../../.env src/events/cli/backfill.ts",
    "projections:replay": "node --env-file-if-exists=../../.env src/events/cli/replay.ts",
    "test:broker": "BROKER_TESTS=1 vitest run test/broker"
  },
  "dependencies": {
    "@daftar/money": "0.1.0",
    "@fastify/cors": "11.4.3",
    "@fastify/otel": "0.21.4",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@fastify/type-provider-zod": "1.0.3",
    "@fastify/under-pressure": "9.2.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@platformatic/kafka": "2.17.0",
    "bullmq": "6.7.8",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "import-in-the-middle": "3.6.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "vitest": "5.1.0"
  }
}
