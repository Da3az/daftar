    "/v1/accounts": {
      "post": {
        "summary": "Create an account.",
        "tags": [
          "accounts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "description": "Opaque client-facing account identifier.",
                    "example": "cash-0001"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "customer_cash",
                      "customer_asset",
                      "house_cash",
                      "house_asset",
                      "external_funding"
                    ]
                  },
                  "assetSymbol": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "openingBalance": {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "description": "Cash amount as an exact decimal string with at most 2 fractional digits. Never a JSON number.",
                    "example": "100.00"
                  }
                },
                "required": [
                  "externalId",
                  "kind"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "externalId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "description": "Opaque client-facing account identifier.",
                      "example": "cash-0001"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "customer_cash",
                        "customer_asset",
                        "house_cash",
                        "house_asset",
                        "external_funding"
                      ]
                    },
                    "assetSymbol": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "balance": {
                      "type": "string",
                      "pattern": "^-?\\d+(\\.\\d+)?$",
                      "description": "Cash amount in minor units, rendered as an exact decimal string.",
                      "example": "1000.00"
